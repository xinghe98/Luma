<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ dark splash: a system-safe symbol hands off to Flutter's full lockup. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/luma_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/luma_splash_symbol</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:navigationBarColor">@color/luma_splash_background</item>
    </style>
</resources>
