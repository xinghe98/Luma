# 跨编辑器统一基础格式，具体语言格式仍交给 gofmt 和 dart format。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yaml,yml,json,jsonc}]
indent_style = space
indent_size = 2

[*.{dart,go}]
indent_style = space

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
