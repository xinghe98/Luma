# Docker 部署的唯一用户配置入口。复制为 .env 后按实际环境修改。
# 该版本会在 Docker 构建时注入 Go 二进制，并显示在 /health 等系统信息中。
LUMA_VERSION=0.1.0

# 宿主机对外监听端口。
LUMA_PORT=8080

# 容器服务身份。留空沿用镜像 luma 用户；上传到 CIFS/NAS 时填挂载对应的数字 UID/GID。
# 例如目录属于 1000:1000 且权限为 755 时，两项都填 1000。
# 身份变化时只迁移 Luma 数据卷权限，不修改媒体目录所有权。
LUMA_UID=
LUMA_GID=

# 媒体目录读写挂载，格式为“宿主机绝对路径=容器目录名”，多个目录以英文逗号分隔。
# 容器目录自动生成在 /media/<名称> 并写入 security.allowed_roots；上传需要容器用户可创建文件。
# 路径中如有空格，请用双引号包住整个值。
LUMA_MEDIA_DIRS=/mnt/TV=tv,/mnt/Movies=movies,/mnt/Photos=photos

# 在线影视刮削。Token 是 TMDb API 设置页签发的 Read Access Token（v4），
# 不要提交真实值；修改后通过 scripts/docker-deploy.sh 重建容器。
LUMA_TMDB_ENABLED=false
LUMA_TMDB_ACCESS_TOKEN=
